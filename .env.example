COMPOSE_PROJECT_NAME=student-lottery-system
DOMAIN=lottery.example.com
POSTGRES_DB=lottery
POSTGRES_USER=lottery
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://lottery:replace-with-a-long-random-password@db:5432/lottery
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional local override; defaults to data/emblems. Docker Compose uses its mounted volume.
EMBLEM_DIR=./data/emblems
EMBLEM_CLEANUP_BATCH_SIZE=50
EMBLEM_CLEANUP_INTERVAL_SECONDS=900

# Used only by the one-time admin creation command; do not commit real values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-before-running
